---
// components
import Container from "../elements/Container.astro";
import Heading from "../elements/Heading.astro";
import Text from "../elements/Text.astro";
import Link from "../elements/Link.astro";
import ContainerBottom from "../elements/ContainerBottom.astro";

// links
const socials = [
    { title: "GitHub", href: "https://github.com/Harish-Raja-R", handle: "@Harish-Raja-R" },
    { title: "LinkedIn", href: "https://linkedin.com/in/harish-raja-r", handle: "in/harish-raja-r" },
    { title: "Email", href: "mailto:harishatgithub@gmail.com", handle: "harishatgithub@gmail.com" },
    { title: "Phone", href: "tel:+916369714360", handle: "+91 63697 14360" }
];

const navigation = [
    { number: "01", title: "Home", href: "/" },
    { number: "02", title: "Work", href: "/works" },
    { number: "03", title: "About", href: "/about" },
    { number: "04", title: "Experience", href: "/experience" },
    { number: "05", title: "Contact", href: "/contact" }
];
---

<footer class="mt-32 border-t-2 border-base-900/30 pt-16 pb-12 bg-base-100/40">
    <Container variant={'xl'}>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
            <!-- Col 1: Identity & Status -->
            <div class="flex flex-col gap-4 text-left">
                <Heading tagName="h3" tagSize="h4" class="text-base-900">Harish Raja R</Heading>
                <Text variant={'sm'} class="text-base-700">
                    AI/ML Engineer & Full-Stack Developer.<br/>
                    Integrated M.Sc. AI & ML at Coimbatore Institute of Technology.<br/>
                    Expected 2029 &bull; CGPA: 9.32
                </Text>
                <div class="inline-flex items-center gap-2 border border-base-900/40 px-3 py-1.5 w-fit font-mono text-12 text-base-900 bg-base-200/40">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>STATUS: READY FOR CHALLENGING ROLES</span>
                </div>
            </div>

            <!-- Col 2: Socials & Contact -->
            <div class="flex flex-col gap-4 text-left">
                <Heading tagName="h3" tagSize="h4" class="text-base-900">Connect</Heading>
                <ul class="flex flex-col gap-2">
                    {
                        socials.map((social) => (
                            <li>
                                <a 
                                    href={social.href} 
                                    target={social.href.startsWith("http") ? "_blank" : undefined}
                                    rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
                                    class="font-mono text-16 text-base-800 hover:text-base-900 hover:underline flex items-center justify-between border-b border-base-900/10 pb-1"
                                >
                                    <span>{social.title}</span>
                                    <span class="text-12 text-base-600">{social.handle}</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Col 3: Numbered Navigation -->
            <div class="flex flex-col gap-4 text-left md:text-right">
                <Heading tagName="h3" tagSize="h4" class="text-base-900">Index</Heading>
                <ul class="flex flex-col gap-2 md:items-end">
                    {
                        navigation.map((navLink) => (
                            <li>
                                <a 
                                    href={navLink.href} 
                                    class="font-grunge text-24 text-base-800 hover:text-base-900 hover:underline uppercase tracking-wide flex items-center gap-2"
                                >
                                    <span class="font-mono text-12 text-base-500">{navLink.number}.</span>
                                    <span>{navLink.title}</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <ContainerBottom />

        <div class="mt-8 pt-8 border-t border-base-900/20 flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
            <Text variant={'xsm'} class="text-base-600">
                HARISH RAJA R &copy; 2026 &bull; COIMBATORE, TAMIL NADU, INDIA &bull; ALL RIGHTS RESERVED
            </Text>
            <Text variant={'xsm'} class="text-base-600">
                PORTFOLIO &bull; DARK GRUNGE SYSTEM &bull; DESIGNED FOR PEAK IMPACT
            </Text>
        </div>
    </Container>
</footer>